# ESP32-P4 target-specific sdkconfig defaults for Waveshare 7B.
#
# Loaded on top of sdkconfig.defaults when target is esp32p4.

# --- MMU page size — 64 KB (P4 spec). ---
CONFIG_MMU_PAGE_SIZE_64KB=y

# --- ESP-Hosted enable ---
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y

# --- ESP-Hosted SDIO for the Waveshare ESP32-P4-WIFI6-Touch-LCD-7B ---
# Uses ESP-Hosted's *default* slot 1 pin map — no overrides needed.
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000

# --- ESP-Hosted task stacks in PSRAM (internal RAM is tight with WiFi +
#     LVGL + mbedtls all wanting internal buffers). ---
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
