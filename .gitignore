# AI agent configuration (local only — never commit)
.claude
.claude/
.claude.md
CLAUDE.md
CLAUDE.MD
.cursorrules
.cursor/
.github/copilot*
.aider*
.continue/
.codeium/
.tabnine*
.sourcery.yaml

# ESP-IDF build artifacts
build/
build_*_*/

# Generated configuration (keep sdkconfig.defaults tracked)
sdkconfig
sdkconfig.old

# ESP-IDF dependency manager
dependencies.lock
managed_components/

# EEZ Studio backups + tmp/ working state
GUI/**/*.eez-project.bak*
GUI/**/*.eez-project-ui-state
tmp/
GUI/tmp/
**/tmp/

# Waveshare vendor source is under DOCS/ for reference — don't commit if
# huge submodules land there. (The wiki-linked ESP-IDF example tree is
# ~50MB and is not needed by CI.)
DOCS/ESP32-P4-WIFI6-Touch-LCD-7B-main/build/

# Log files and temporary files
*.log
*.o
*.pyc
__pycache__/
.pytest_cache/
pytest_embedded_log/

# IDEs
.vscode/
.idea/
.clangd
.ccls-cache/
*.swp
*.swo
.cache/

# OS files
.DS_Store
Thumbs.db

# Temporary/backup files
*.orig
*.tmp
scripts/

# FreeCAD temporary and backup files
.xdp-*
*.FCBak*
*.FCStd1
*.FCStd2

# Secrets, credentials, and provisioning data — NEVER commit
.env
.env.*
*.env
env.local
secrets/
credentials/
*.secret
*_secret.*
*_secrets.*
provisioning.json
wifi_credentials.*
mqtt_credentials.*

# Certificates and private keys
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore

# NVS partition images (often contain baked WiFi PSKs, MQTT creds, TLS keys)
nvs.bin
nvs_*.bin
*.nvs.bin
nvs_partition/
factory_nvs/

# Flashed firmware / release artifacts landing outside build/
*.bin
*.elf
*.map
*.hex
!partitions.csv

# ESP-IDF core dumps and coredump ELFs
core_dump.*
coredump/
*.coredump

# esp-idf ci / local variants that may embed credentials
sdkconfig.ci
sdkconfig.local
sdkconfig.*.local

# Python virtual environments and tooling
.venv/
venv/
env/
.python-version
.mypy_cache/
.ruff_cache/
.tox/

# Coverage and profiling
.coverage
.coverage.*
htmlcov/
coverage.xml
*.gcov
*.gcda
*.gcno

# Editor scratch / crash recovery
*~
.*.swp
.*.swo
.netrwhist
Session.vim
.direnv/
.envrc

# macOS extended attributes / resource forks
._*
.AppleDouble
.LSOverride
